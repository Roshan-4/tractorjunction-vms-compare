{
  "name": "tractorjunction-vms-compare",
  "version": "1.0.0",
  "description": "Daily check that used-tractor listings on tractorjunction.com match VMS",
  "scripts": {
    "daily:tractor-vs-vms": "node auth/daily-tractorjunction-vs-vms.js",
    "vms:prod-auth": "node auth/vms-prod-token-login.js",
    "sheet:update": "node auth/google-sheet.js",
    "cliq:send": "node auth/zoho-cliq.js",
    "cliq:token": "node auth/zoho-cliq.js token",
    "location:export": "node db/export-location-map.js",
    "location:secret": "node -e \"process.stdout.write(require('zlib').gzipSync(require('fs').readFileSync('data/location-map.json'),{level:9}).toString('base64'))\" | gh secret set LOCATION_MAP_GZ_B64"
  },
  "keywords": [],

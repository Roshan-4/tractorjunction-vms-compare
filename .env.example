# Copy to .env and fill in real values. .env is gitignored; CI uses GitHub secrets.

# VMS production API — verify the token with: npm run vms:prod-auth
VMS_API_BASE=
PROD_VMS_TOKEN=

# TractorJunction STAGING DB (read-only, office network only) — used only by
# npm run location:export to build data/location-map.json; not needed by CI
ROOT_DB_HOST=
ROOT_DB_PORT=3306
ROOT_DB_DATABASE=
ROOT_DB_USERNAME=
ROOT_DB_PASSWORD=

# Zoho Cliq — report is posted to this channel (auth/zoho-cliq.js)
# Self Client from https://api-console.zoho.in ; scope ZohoCliq.Webhooks.CREATE
ZOHO_ACCOUNTS_DC=https://accounts.zoho.in
CLIQ_API_BASE=https://cliq.<your-domain>/company/<org id>
CLIQ_CLIENT_ID=
CLIQ_CLIENT_SECRET=
ZOHO_CLIQ_CHANNEL=
# Filled in by: npm run cliq:token -- <grant code>
CLIQ_REFRESH_TOKEN=

# Google Sheet that holds the latest report (auth/google-sheet.js)
SHEET_NAME=
SHEET_ID=
# Apps Script web app bound to the sheet (auth/apps-script/report-sheet.gs)
SHEET_WEBAPP_URL=
SHEET_WEBAPP_SECRET=
